    "shop",
    "devsecops",
    "microservice"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "supertest": "^7.0.0"
  }
}
