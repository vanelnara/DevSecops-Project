{
  "name": "simple-shop",
  "version": "1.0.0",
  "description": "DevSecOps microservice - Simple Shop",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test tests/api.test.js",
