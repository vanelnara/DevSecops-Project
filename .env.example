# Shared PostgreSQL (existing Jenkins DB or local docker-compose)
JENKINS_DB_HOST=127.0.0.1
JENKINS_DB_PORT=5432
JENKINS_DB_NAME=jenkins
JENKINS_DB_USER=jenkins
JENKINS_DB_PASSWORD=jenkins

# Ingest bridge (Jenkins -> dashboard)
INGEST_URL=http://127.0.0.1:4200/ingest/build
INGEST_TOKEN=
INGEST_PORT=4200

# Hugging Face AI analyzer (runs alongside the dashboard on :4300)
# 1) Create token: https://huggingface.co/settings/tokens
# 2) Jenkins Secret text credential ID: huggingface-api-key
AI_PORT=4300
AI_ANALYZER_URL=http://127.0.0.1:4300
AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest
HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
AI_TIMEOUT_MS=45000

# Dashboard API
DASHBOARD_API_PORT=4100
DASHBOARD_MOCK_FALLBACK=false
