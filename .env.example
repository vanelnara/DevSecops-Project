# Shared PostgreSQL (existing Jenkins DB or local docker-compose)
JENKINS_DB_HOST=127.0.0.1
JENKINS_DB_PORT=5432
JENKINS_DB_NAME=jenkins
JENKINS_DB_USER=jenkins
JENKINS_DB_PASSWORD=jenkins

# Ingest bridge (Jenkins -> dashboard)
INGEST_URL=http://127.0.0.1:4200/ingest/build
INGEST_TOKEN=
INGEST_PORT=4200

# DeepSeek AI analyzer
AI_PORT=4300
AI_ANALYZER_URL=http://127.0.0.1:4300
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat

# Dashboard API
DASHBOARD_API_PORT=4100
DASHBOARD_MOCK_FALLBACK=true
