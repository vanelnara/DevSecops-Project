# Shared PostgreSQL — same DB Jenkins / ingest / AI / dashboard use
JENKINS_DB_HOST=127.0.0.1
JENKINS_DB_PORT=5432
JENKINS_DB_NAME=jenkins
JENKINS_DB_USER=jenkins
JENKINS_DB_PASSWORD=jenkins

# Inside Docker Compose, services reach DB via COMPOSE_DB_HOST
# (postgres container alias, or host.docker.internal when reusing host DB)
COMPOSE_DB_HOST=postgres

# Ingest bridge (Jenkins host -> published container port)
INGEST_URL=http://127.0.0.1:4200/ingest/build
INGEST_TOKEN=
INGEST_PORT=4200

# Hugging Face AI analyzer
AI_PORT=4300
AI_ANALYZER_URL=http://127.0.0.1:4300
AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest
HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
AI_TIMEOUT_MS=45000

# Dashboard API (login UI + JSON API). Default login: admin / admin
DASHBOARD_API_PORT=4100
DASHBOARD_MOCK_FALLBACK=false

# Optional overrides for monitoring (defaults work on the Jenkins agent)
GRAFANA_URL=http://127.0.0.1:3030
PUSHGATEWAY_URL=http://127.0.0.1:9091
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
