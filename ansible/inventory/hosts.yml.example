# Example Ansible inventory — copy to hosts.yml and edit
all:
  children:
    jenkins:
      hosts:
        jenkins1:
          ansible_host: 192.168.10.149
          ansible_user: ubuntu
          # ansible_ssh_private_key_file: ~/.ssh/id_rsa
    k8s:
      hosts:
        k8s1:
          ansible_host: 192.168.10.150
          ansible_user: ubuntu
  vars:
    ansible_python_interpreter: /usr/bin/python3
