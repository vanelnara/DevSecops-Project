---
# Copy to vars/credentials.yml — NEVER commit this file with real passwords
# Used for reference only; add credentials manually in Jenkins UI

# GitHub — use Personal Access Token (recommended) not account password
# https://github.com/settings/tokens
github_username: "YOUR_GITHUB_USERNAME"
github_token: "YOUR_GITHUB_PAT"

# Docker Hub — sneproject/devsecops-project
dockerhub_username: "YOUR_DOCKERHUB_USERNAME"
dockerhub_password: "YOUR_DOCKERHUB_PASSWORD"

# SonarQube — generate a User, Project Analysis, or Global Analysis token at:
# http://192.168.10.149:9000 → My Account → Security → Generate Tokens
# Add it to Jenkins as "Secret text" with ID: sonarqube-token.
# A user token owner needs "Execute Analysis" on devsecops-simple-shop.
# Create the project first, or also grant "Create Projects".
sonarqube_token: "YOUR_SONAR_TOKEN"

# NVD API — request at https://nvd.nist.gov/developers/request-an-api-key
# Add it to Jenkins as "Secret text" with ID: nvd-api-key.
nvd_api_key: "YOUR_NVD_API_KEY"

# Argo CD — admin password from server:
# kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d
argocd_admin_password: "YOUR_ARGOCD_ADMIN_PASSWORD"

# Cosign — generate an encrypted key pair and never commit cosign.key.
# Jenkins Secret file ID: cosign-private-key
# Jenkins Secret text ID: cosign-password
cosign_password: "YOUR_COSIGN_KEY_PASSWORD"

# PostgreSQL — Jenkins Secret text ID: jenkins-db-password
# Bound in Jenkinsfile as JENKINS_DB_PASSWORD = credentials('jenkins-db-password')
# Use the password you set with: ALTER USER jenkins WITH PASSWORD '...';
jenkins_db_password: "YOUR_POSTGRES_JENKINS_USER_PASSWORD"

# Hugging Face — Jenkins Secret text ID: huggingface-api-key
# Bound in Jenkinsfile as HUGGINGFACE_API_KEY = credentials('huggingface-api-key')
# Create at https://huggingface.co/settings/tokens
huggingface_api_key: "YOUR_HUGGINGFACE_API_KEY"

# Grafana — admin UI password (optional Jenkins env GRAFANA_PASSWORD)
# Default lab login admin/admin on http://<host>:3030
grafana_admin_password: "admin"

# Grafana SMTP — Gmail App Password for alert emails to naravanel31@gmail.com
# Put this in monitoring/.env as GF_SMTP_PASSWORD (never commit)
# https://myaccount.google.com/apppasswords
grafana_smtp_password: "YOUR_GMAIL_APP_PASSWORD"

